{
  "name": "living-architecture-nodes-vscode",
  "displayName": "Living Architecture Nodes",
  "description": "Keep codebase architecture memory current: detect missing or stale nodes, review drift, and export local AI/dev handoff context.",
  "version": "0.1.1",
  "publisher": "altrudev",
  "author": {
    "name": "Valentyn Rukhaylo / Altru.dev"
  },
  "private": false,
  "pricing": "Free",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://altru.dev/living-architecture-nodes",
  "repository": {
    "type": "git",
    "url": "https://github.com/altrudev/living-architecture-nodes-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/altrudev/living-architecture-nodes-vscode/issues"
  },
  "qna": false,
  "markdown": "github",
  "icon": "media/lan-marketplace.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.92.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Read-only architecture-memory scanning remains available. File generation and diagnostic exports require Workspace Trust.",
      "restrictedConfigurations": [
        "livingArchitectureNodes.sourceExtensions",
        "livingArchitectureNodes.excludeGlobs",
        "livingArchitectureNodes.exportPath"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Living Architecture Nodes requires a workspace filesystem for architecture-memory scanning and local exports."
    }
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "software architecture",
    "architecture memory",
    "architecture drift",
    "AI assisted development",
    "AI coding",
    "codebase knowledge",
    "developer tools",
    "documentation",
    "diagnostics",
    "technical debt",
    "dependency analysis",
    "regression memory",
    "repository maintenance",
    "handoff"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:livingArchitectureNodes.statusView",
    "onCommand:livingArchitectureNodes.scanWorkspace",
    "onCommand:livingArchitectureNodes.generateMissingNodes",
    "onCommand:livingArchitectureNodes.exportHandoffBundle",
    "onCommand:livingArchitectureNodes.openARCH",
    "onCommand:livingArchitectureNodes.openNERVE",
    "onCommand:livingArchitectureNodes.openChangelog",
    "onCommand:livingArchitectureNodes.showProductStatus"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "livingArchitectureNodes",
          "title": "Living Architecture Nodes",
          "icon": "media/lan-icon.svg"
        }
      ]
    },
    "views": {
      "livingArchitectureNodes": [
        {
          "id": "livingArchitectureNodes.statusView",
          "name": "Architecture Memory"
        }
      ]
    },
    "commands": [
      {
        "command": "livingArchitectureNodes.scanWorkspace",
        "title": "Living Architecture Nodes: Scan Workspace",
        "icon": "$(search)"
      },
      {
        "command": "livingArchitectureNodes.generateMissingNodes",
        "title": "Living Architecture Nodes: Generate Missing Node Files",
        "icon": "$(new-file)"
      },
      {
        "command": "livingArchitectureNodes.exportHandoffBundle",
        "title": "Living Architecture Nodes: Export AI/Dev Handoff Bundle",
        "icon": "$(export)"
      },
      {
        "command": "livingArchitectureNodes.openARCH",
        "title": "Living Architecture Nodes: Open ARCH.md",
        "icon": "$(file-code)"
      },
      {
        "command": "livingArchitectureNodes.openNERVE",
        "title": "Living Architecture Nodes: Open NERVE.md",
        "icon": "$(pulse)"
      },
      {
        "command": "livingArchitectureNodes.openChangelog",
        "title": "Living Architecture Nodes: Open CHANGELOG.node.md",
        "icon": "$(history)"
      },
      {
        "command": "livingArchitectureNodes.showProductStatus",
        "title": "Living Architecture Nodes: Show Product Status",
        "icon": "$(shield)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "livingArchitectureNodes.scanWorkspace",
          "when": "view == livingArchitectureNodes.statusView",
          "group": "navigation"
        },
        {
          "command": "livingArchitectureNodes.exportHandoffBundle",
          "when": "view == livingArchitectureNodes.statusView && isWorkspaceTrusted",
          "group": "navigation"
        },
        {
          "command": "livingArchitectureNodes.showProductStatus",
          "when": "view == livingArchitectureNodes.statusView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "livingArchitectureNodes.generateMissingNodes",
          "when": "view == livingArchitectureNodes.statusView && viewItem == lanMissingNode && isWorkspaceTrusted",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Living Architecture Nodes",
      "properties": {
        "livingArchitectureNodes.sourceExtensions": {
          "type": "array",
          "default": [
            ".js",
            ".jsx",
            ".ts",
            ".tsx",
            ".mjs",
            ".cjs",
            ".py",
            ".cs",
            ".java",
            ".go",
            ".rs",
            ".php",
            ".rb",
            ".swift",
            ".kt",
            ".kts",
            ".vue",
            ".svelte",
            ".html",
            ".css",
            ".yml",
            ".yaml"
          ],
          "description": "Source file extensions that should have companion .node.md files."
        },
        "livingArchitectureNodes.excludeGlobs": {
          "type": "array",
          "default": [
            "**/.git/**",
            "**/node_modules/**",
            "**/dist/**",
            "**/build/**",
            "**/out/**",
            "**/coverage/**",
            "**/.next/**",
            "**/.nuxt/**",
            "**/.turbo/**",
            "**/.cache/**",
            "**/vendor/**",
            "**/.venv/**",
            "**/venv/**",
            "**/__pycache__/**",
            "**/.lan-vscode/**"
          ],
          "description": "Glob patterns excluded from scanning."
        },
        "livingArchitectureNodes.exportPath": {
          "type": "string",
          "default": ".lan-vscode",
          "description": "Workspace-relative folder for diagnostic exports. Export paths are confined to the trusted workspace."
        }
      }
    }
  },
  "scripts": {
    "self-check": "node scripts/self-check.js",
    "release:check": "node scripts/release-check.js",
    "test:product": "node --test test/*.test.js",
    "test": "npm run self-check && npm run release:check && npm run test:product",
    "package": "npx --yes @vscode/vsce package"
  },
  "devDependencies": {}
}
